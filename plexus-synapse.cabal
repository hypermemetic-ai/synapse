test-suite keychain-test
  -- SELF-8 keychain tests. Opt-in via `-f build-keychain-tests` because
  -- they shell out to macOS `security` and touch the real keychain.
  type:             exitcode-stdio-1.0
  main-is:          KeychainSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-synapse,
    text >= 2.0 && < 2.2,
    hspec >= 2.10 && < 2.12,
    uuid >= 1.3 && < 1.4
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded
  if !flag(build-keychain-tests)
    buildable: False
