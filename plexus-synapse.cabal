    text >= 2.0 && < 2.2,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6 && < 0.8,
    aeson >= 2.2 && < 2.3,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    hspec >= 2.10 && < 2.12,
    time >= 1.12 && < 1.15,
    temporary >= 1.3 && < 1.4,
    base64-bytestring >= 1.2 && < 1.3,
