    RecordWildCards
  ghc-options:      -threaded

test-suite credential-ir-test
  -- AUTHZ-CRED-IR-1: golden-file + round-trip tests for credential
  -- metadata projection onto MethodSchema / MethodDef.
  type:             exitcode-stdio-1.0
  main-is:          CredentialIRSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    aeson-qq >= 0.8 && < 0.9,
