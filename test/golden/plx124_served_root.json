      "description": "Echo messages back - demonstrates plexus-macros usage",
      "edge": "static",
      "hash": "14e684c862f0e804ba60c22f11a67fde26af8644e7077e3a92d5699cc089214b",
      "long_description": "Hub-macro generates all the boilerplate for this impl block:\n- `EchoRpc` trait with JSON-RPC subscription methods\n- `EchoRpcServer` implementation\n- Activation trait implementation\n- `EchoMethod` enum with JSON schemas",
      "methods": [
        {
          "auth": "public",
          "description": "Echo a message back the specified number of times",
          "dotted_id": "echo.echo",
          "hash": "aa0fd3408f46315a26d3b288ffb2163f0536992d12a15204fe59c26022c06b7e",
          "http_method": "POST",
          "name": "echo",
          "params": [
            {
              "description": "The message to echo",
              "name": "message",
              "required": true,
              "schema": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "title": "string",
                  "type": "string"
                },
                "type_name": "String"
              }
            },
            {
              "description": "Number of times to repeat (default: 1)",
              "name": "count",
              "required": true,
              "schema": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "format": "uint32",
                  "minimum": 0,
                  "title": "uint32",
                  "type": "integer"
                },
                "type_name": "u32"
              }
            }
          ],
          "updates": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "description": "Events from echo operations",
              "oneOf": [
                {
                  "description": "Echo response",
                  "properties": {
                    "count": {
                      "description": "Number of times repeated",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "message": {
                      "description": "The echoed message",
                      "type": "string"
                    },
                    "type": {
                      "const": "echo",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "count"
                  ],
                  "type": "object"
                },
                {
                  "description": "Pong response (from ping)",
                  "properties": {
                    "type": {
                      "const": "pong",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "type": "object"
                }
              ],
              "title": "EchoEvent"
            },
            "type_name": "EchoEvent"
          }
        }
      ],
      "namespace": "echo",
      "version": "1.0.0"
    },
