      "description": "Solar system model - demonstrates nested plugin hierarchy",
      "edge": "static",
      "hash": "551afcdf106b444d239b4fddc9dc1c5c2f05c062678b025d39c830c6df7671e1",
      "long_description": "Solar system model - demonstrates nested plugin hierarchy",
      "methods": [
        {
          "auth": "public",
          "description": "Get an overview of the solar system",
          "dotted_id": "solar.observe",
          "hash": "215389c26479047962ef919e4d7a1a5a9327012771e29e692412947f4a5c9284",
          "http_method": "POST",
          "name": "observe",
          "updates": {
            "schema": {
              "$defs": {
                "BodyType": {
                  "description": "Type of celestial body",
                  "enum": [
                    "star",
                    "planet",
                    "dwarf_planet",
                    "moon"
                  ],
                  "type": "string"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "description": "Events from solar system observations",
              "oneOf": [
                {
                  "description": "Information about a celestial body",
                  "properties": {
                    "body_type": {
                      "$ref": "#/$defs/BodyType"
                    },
                    "mass_kg": {
                      "format": "double",
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "orbital_period_days": {
                      "format": "double",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "parent": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "radius_km": {
                      "format": "double",
                      "type": "number"
                    },
                    "type": {
                      "const": "body",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "body_type",
                    "mass_kg",
                    "radius_km"
                  ],
                  "type": "object"
                },
                {
                  "description": "System overview",
                  "properties": {
                    "moon_count": {
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "planet_count": {
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "star": {
                      "type": "string"
                    },
                    "total_bodies": {
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": {
                      "const": "system",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "star",
                    "planet_count",
                    "moon_count",
                    "total_bodies"
                  ],
                  "type": "object"
                }
              ],
              "title": "SolarEvent"
            },
            "type_name": "SolarEvent"
          }
        }
      ],
      "namespace": "solar",
      "version": "1.0.0"
    },
